{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "fluencytalks.com" }], "destination": "https://thefluencytalks.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.fluencytalks.com" }], "destination": "https://thefluencytalks.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.thefluencytalks.com" }], "destination": "https://thefluencytalks.com/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ]
}

