# Copy to .env and fill in real values. Never commit .env with secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Raises the free daily quota of the tap-to-translate provider (MyMemory).
VITE_TRANSLATE_EMAIL=
# Unsplash image search: the key is a SERVER secret. Do not put it here or use a VITE_ prefix.
# Set it with:  supabase secrets set UNSPLASH_ACCESS_KEY=your-key   (then: supabase functions deploy unsplash-proxy)
# ---- Contact inboxes (all @thefluencytalks.com) ----
# Already created: info, support, security, report.
# Recommended to create: terms, privacy (legal + GDPR/CCPA requests).
VITE_EMAIL_INFO=info@thefluencytalks.com
VITE_EMAIL_SUPPORT=support@thefluencytalks.com
VITE_EMAIL_SECURITY=security@thefluencytalks.com
VITE_EMAIL_REPORT=report@thefluencytalks.com
VITE_EMAIL_TERMS=terms@thefluencytalks.com
VITE_EMAIL_PRIVACY=privacy@thefluencytalks.com

# Web push. Public half only; pairs with VAPID_PRIVATE_KEY, which is a server secret (supabase secrets set).
# Generate a pair with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Calls need nothing here: the browser receives the LiveKit URL together with its token.
# LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET are SERVER secrets: put them in supabase/functions/.env
# locally (gitignored) and `supabase secrets set` on a hosted project. Never with a VITE_ prefix.

# Parent or guardian consent for members aged 12 to 15 (supabase/functions/guardian-consent). SERVER secrets, never VITE_:
# RESEND_API_KEY, GUARDIAN_EMAIL_FROM ("The Fluency Talks <consent@your-domain>", a domain verified with Resend)
# and PUBLIC_SITE_URL (where /guardian is served). Without them a minor's request answers "email_unavailable".
