# Copy to .env and fill in real values. Never commit .env with secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Raises the free daily quota of the tap-to-translate provider (MyMemory).
VITE_TRANSLATE_EMAIL=
UNSPLASH_ACCESS_KEY =
# ---- Contact inboxes (all @thefluencytalks.com) ----
# Already created: info, support, security, report.
# Recommended to create: terms, privacy (legal + GDPR/CCPA requests).
VITE_EMAIL_INFO=info@thefluencytalks.com
VITE_EMAIL_SUPPORT=support@thefluencytalks.com
VITE_EMAIL_SECURITY=security@thefluencytalks.com
VITE_EMAIL_REPORT=report@thefluencytalks.com
VITE_EMAIL_TERMS=terms@thefluencytalks.com
VITE_EMAIL_PRIVACY=privacy@thefluencytalks.com
