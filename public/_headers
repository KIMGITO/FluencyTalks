# Cloudflare Pages _headers — mirrors the header rules previously in vercel.json.
/sitemap.xml
  Content-Type: application/xml

/robots.txt
  Content-Type: text/plain

# Kept out of search without needing JavaScript. (Not blocked in robots.txt: Google must be able to read this.)
/login
  X-Robots-Tag: noindex, nofollow
/signup
  X-Robots-Tag: noindex, nofollow
/forgot-password
  X-Robots-Tag: noindex, nofollow
/reset-password
  X-Robots-Tag: noindex, nofollow
/onboarding
  X-Robots-Tag: noindex, nofollow
/app
  X-Robots-Tag: noindex, nofollow
/app.html
  X-Robots-Tag: noindex, nofollow

# Fingerprinted build files can be cached for a year; the HTML is revalidated every time.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be served stale.
/sw.js
  Cache-Control: no-cache
